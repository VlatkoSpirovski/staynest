DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staynest?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional email delivery. Without these, verification emails are printed in the dev server terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="StayNest <hello@staynest.app>"

# Optional image uploads. Without these, paste image URLs in the fallback fields.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="staynest"

# Optional guest AI assistant. Without this, the public chat asks guests to contact the host.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Optional Google owner login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server-only Geoapify key for cheaper host-side place search. Never expose this as NEXT_PUBLIC_*.
GEOAPIFY_API_KEY=""

# Optional PayPal subscriptions. Use sandbox while testing, live for production.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASIC_PLAN_ID=""
PAYPAL_AI_PLAN_ID=""

# Optional Paddle subscriptions. Use sandbox while testing, production for live payments.
PADDLE_ENV="production"
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_BASIC_PRICE_ID=""
PADDLE_AI_PRICE_ID=""
PADDLE_WEBHOOK_SECRET=""
